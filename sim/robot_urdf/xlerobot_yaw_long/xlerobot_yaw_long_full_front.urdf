<?xml version="1.0"?>
<robot name="xlerobot_yaw_long">
  <link name="world">
    <inertial>
      <mass value="0"/>
      <inertia ixx="0.00" ixy="0.00" ixz="0.00" iyy="0.00" iyz="0.00" izz="0.00"/>
    </inertial>
  </link>

  <!-- Chassis links (dummy links) -->
    <link name="chassis_link_1">
      <inertial>
        <mass value="0.00001" />
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
      </inertial>
    </link>
    <link name="chassis_link_2">
      <inertial>
        <mass value="0.0001" />
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
      </inertial>
    </link>
  <!-- Chassis SE(2) dofs-->
  <joint name="chassis_x" type="prismatic">
    <parent link="world"/>
    <child link="chassis_link_1"/>
    <axis xyz="1 0 0"/>
    <limit effort="100" lower="-20" upper="20" velocity="0.50"/>
    <dynamics damping="10.0" friction="10"/>
  </joint>
  <joint name="chassis_y" type="prismatic">
    <parent link="chassis_link_1"/>
    <child link="chassis_link_2"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="-20" upper="20" velocity="0.50"/>
    <dynamics damping="10.0" friction="10"/>
  </joint>
  <joint name="chassis_z_rot" type="continuous">
    <parent link="chassis_link_2"/>
    <child link="base"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="10.0" friction="1"/>
  </joint>
